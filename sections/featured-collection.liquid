{% schema %}{"name":"Featured collection","settings":[{"type":"text","id":"title","label":"Heading","default":"A few good finds"},{"type":"collection","id":"collection","label":"Collection"},{"type":"range","id":"products_to_show","label":"Products to show","min":2,"max":8,"step":2,"default":4},{"type":"text","id":"link_label","label":"Link label","default":"View all products"}]}{% endschema %}
<section class="product-section page-width"><div class="section-heading"><div><span class="eyebrow">THE REALZY EDIT</span><h2>{{ section.settings.title }}</h2></div><a class="text-link" href="{{ section.settings.collection.url | default: routes.all_products_collection_url }}">{{ section.settings.link_label }} <span aria-hidden="true">↗</span></a></div>{% assign collection = section.settings.collection %}<div class="product-grid">{% if collection != blank and collection.products_count > 0 %}{% for product in collection.products limit: section.settings.products_to_show %}{% render 'product-card', product: product %}{% endfor %}{% else %}<div class="empty-products"><p>Your product edit is coming together.</p><a href="/admin/collections">Add products in Shopify admin, then choose a collection in the theme editor.</a></div>{% endif %}</div></section>
