{% schema %}{"name":"Wholesale callout","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"FOR BUSINESS & BIG IDEAS"},{"type":"text","id":"title","label":"Heading","default":"Let’s make something good happen."},{"type":"textarea","id":"body","label":"Text","default":"Looking for volume pricing, custom sourcing, or a dependable supply partner? Tell us what you need and our team will help you find the right fit."},{"type":"text","id":"button_label","label":"Button label","default":"Talk to our team"},{"type":"url","id":"button_link","label":"Button link","default":"/pages/contact"}]}{% endschema %}
<section class="wholesale-band"><div class="wholesale-shape">R<span>↗</span></div><div class="wholesale-copy"><span class="eyebrow">{{ section.settings.eyebrow }}</span><h2>{{ section.settings.title }}</h2><p>{{ section.settings.body }}</p><a class="button button-light" href="{{ section.settings.button_link }}">{{ section.settings.button_label }} <span aria-hidden="true">↗</span></a></div></section>
