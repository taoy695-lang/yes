<section class="basic-page page-width cart-page"><span class="eyebrow">YOUR PICKS</span><h1>Your bag</h1>{% if cart.item_count > 0 %}<form action="{{ routes.cart_url }}" method="post"><div class="cart-items">{% for item in cart.items %}<div class="cart-item"><a href="{{ item.url }}">{% if item.image %}{{ item.image | image_url: width: 180 | image_tag: loading: 'lazy', alt: item.title }}{% endif %}</a><div><a class="product-title" href="{{ item.url }}">{{ item.product.title }}</a><p>{{ item.variant.title }}</p><label for="updates_{{ item.key }}">Qty</label><input id="updates_{{ item.key }}" type="number" name="updates[]" value="{{ item.quantity }}" min="0"></div><strong>{{ item.final_line_price | money }}</strong></div>{% endfor %}</div><div class="cart-summary"><p>Subtotal <strong>{{ cart.total_price | money }}</strong></p><p class="shipping-note">Shipping, taxes, and discounts are calculated at checkout.</p><button class="button button-outline" type="submit" name="update">Update bag</button><button class="button button-dark" type="submit" name="checkout">Continue to checkout ↗</button></div></form>{% else %}<p>Your bag is taking a breather.</p><a class="button button-dark" href="{{ routes.all_products_collection_url }}">Explore the collection</a>{% endif %}</section>
