<section class="collection-page page-width"><div class="collection-intro"><span class="eyebrow">FIND YOUR NEXT FAVORITE</span><h1>Search</h1><form action="{{ routes.search_url }}" method="get" class="search-form"><input type="search" name="q" value="{{ search.terms | escape }}" placeholder="What are you looking for?"><button class="button button-dark" type="submit">Search ↗</button></form></div>{% if search.performed %}<p class="search-count">{{ search.results_count }} results for “{{ search.terms }}”</p><div class="product-grid">{% for item in search.results %}{% if item.object_type == 'product' %}{% render 'product-card', product: item %}{% else %}<a class="search-page-result" href="{{ item.url }}"><h2>{{ item.title }}</h2><p>{{ item.content | strip_html | truncate: 150 }}</p></a>{% endif %}{% else %}<p>No matches yet. Try another search.</p>{% endfor %}</div>{% endif %}</section>
