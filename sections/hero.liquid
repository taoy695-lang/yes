{% schema %}{"name":"Hero","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"A little more you, every day"},{"type":"text","id":"title","label":"Heading","default":"Find your kind\nof good."},{"type":"textarea","id":"body","label":"Text","default":"A considered collection of everyday essentials and unexpected favorites. Made for wherever life takes you."},{"type":"text","id":"button_label","label":"Button label","default":"Explore the collection"},{"type":"url","id":"button_link","label":"Button link"},{"type":"text","id":"image_url","label":"Hero image URL","info":"Add an image URL, or choose a photo in the theme editor by replacing this placeholder."}]}{% endschema %}
<section class="hero"><div class="hero-copy"><span class="eyebrow">{{ section.settings.eyebrow }}</span><h1>{{ section.settings.title | newline_to_br }}</h1><p>{{ section.settings.body }}</p><a class="button button-dark" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }} <span aria-hidden="true">↗</span></a><div class="hero-note"><span class="note-mark">✳</span> Curated with care. Ready for anywhere.</div></div><div class="hero-art"{% if section.settings.image_url != blank %} style="background-image:url('{{ section.settings.image_url | escape }}')"{% endif %}><div class="art-orbit orbit-one"></div><div class="art-orbit orbit-two"></div><div class="art-sun"></div><div class="art-label">GOOD<br>THINGS<br>LIVE HERE</div><span class="art-caption">REALZY — everyday, elevated</span></div></section>
