{% schema %}{"name":"Main page","settings":[]} {% endschema %}<section class="basic-page page-width"><span class="eyebrow">REALZY</span><h1>{{ page.title }}</h1><div class="rte">{{ page.content }}</div>{% if page.handle == 'contact' %}{% form 'contact', class: 'contact-form' %}{% if form.posted_successfully? %}<p class="form-success">Thanks for reaching out. Our team will be in touch soon.</p>{% endif %}{{ form.errors | default_errors }}<label for="ContactName">Name</label><input id="ContactName" type="text" name="contact[name]" value="{{ form.name }}" required><label for="ContactEmail">Email</label><input id="ContactEmail" type="email" name="contact[email]" value="{{ form.email }}" required><label for="ContactCompany">Company (optional)</label><input id="ContactCompany" type="text" name="contact[company]"><label for="ContactMessage">How can we help?</label><textarea id="ContactMessage" name="contact[body]" rows="6" required>{{ form.body }}</textarea><button class="button button-dark" type="submit">Send inquiry ↗</button>{% endform %}{% endif %}</section>
