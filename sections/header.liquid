{% schema %}{"name":"Header","settings":[{"type":"text","id":"menu_label","label":"Menu label","default":"Shop"}]}{% endschema %}
<header class="site-header"><div class="header-inner"><a class="wordmark" href="{{ routes.root_url }}" aria-label="{{ shop.name }} home">REALZY<span class="wordmark-dot">.</span></a><nav class="desktop-nav" aria-label="Main navigation"><a href="{{ routes.all_products_collection_url }}">{{ section.settings.menu_label }}</a><a href="{{ routes.all_products_collection_url }}?sort_by=best-selling">Best sellers</a><a href="/pages/wholesale">Wholesale</a><a href="/pages/contact">Contact</a></nav><div class="header-actions"><a class="icon-link" href="{{ routes.search_url }}" aria-label="Search">Search</a><a class="icon-link cart-link" href="{{ routes.cart_url }}" aria-label="Shopping bag">Bag <span class="cart-count">{{ cart.item_count }}</span></a><button class="menu-toggle" type="button" aria-expanded="false" aria-label="Open menu">Menu</button></div></div><nav class="mobile-nav" aria-label="Mobile navigation" hidden><a href="{{ routes.all_products_collection_url }}">Shop all</a><a href="{{ routes.all_products_collection_url }}?sort_by=best-selling">Best sellers</a><a href="/pages/wholesale">Wholesale</a><a href="/pages/contact">Contact</a></nav></header>
