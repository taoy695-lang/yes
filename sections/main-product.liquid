{% schema %}{"name":"Main product","settings":[]} {% endschema %}<section class="product-detail page-width"><div class="product-media">{% if product.media.size > 0 %}{% for media in product.media %}<div class="product-media-item">{% if media.media_type == 'image' %}{{ media | image_url: width: 1200 | image_tag: loading: 'lazy', alt: media.alt | default: product.title }}{% else %}{{ media | media_tag }}{% endif %}</div>{% endfor %}{% else %}<div class="image-placeholder product-placeholder"><span>REALZY</span></div>{% endif %}</div><div class="product-info"><span class="eyebrow">{{ product.vendor | default: shop.name }}</span><h1>{{ product.title }}</h1><div class="product-price">{% if product.price_varies %}From {% endif %}{{ product.price | money }}{% if product.compare_at_price > product.price %}<s>{{ product.compare_at_price | money }}</s>{% endif %}</div>{% if product.description != blank %}<div class="rte product-description">{{ product.description }}</div>{% endif %}{% form 'product', product, class: 'product-form' %}{% if product.has_only_default_variant == false %}<label for="VariantSelect">Options</label><select id="VariantSelect" name="id">{% for variant in product.variants %}<option value="{{ variant.id }}" {% if variant == product.selected_or_first_available_variant %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>{{ variant.title }} — {{ variant.price | money }}{% unless variant.available %} (Sold out){% endunless %}</option>{% endfor %}</select>{% else %}<input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">{% endif %}<label for="Quantity">Quantity</label><input id="Quantity" type="number" name="quantity" value="1" min="1"><button class="button button-dark add-to-cart" type="submit" {% unless product.available %}disabled{% endunless %}>{% if product.available %}Add to bag{% else %}Sold out{% endif %}</button>{{ form | payment_button }}{% if form.errors %}<div class="form-error">{{ form.errors | default_errors }}</div>{% endif %}{% endform %}<p class="shipping-note">Secure checkout · Shipping options shown at checkout</p><a class="text-link inquire-link" href="/pages/contact?product={{ product.title | url_encode }}">Need volume pricing or a custom quote? Ask us ↗</a></div></section>
