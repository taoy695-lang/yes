<article class="product-card"><a class="product-image" href="{{ product.url }}">{% if product.featured_image %}{{ product.featured_image | image_url: width: 720 | image_tag: loading: 'lazy', alt: product.featured_image.alt | default: product.title }}{% else %}<div class="image-placeholder"><span>REALZY</span></div>{% endif %}{% if product.available == false %}<span class="badge">Sold out</span>{% elsif product.compare_at_price > product.price %}<span class="badge">A good deal</span>{% endif %}</a><div class="product-card-info"><a href="{{ product.url }}" class="product-title">{{ product.title }}</a><span class="price">{% if product.price_varies %}From {% endif %}{{ product.price | money }}{% if product.compare_at_price > product.price %}<s>{{ product.compare_at_price | money }}</s>{% endif %}</span></div></article>
